        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-105" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="&lt;font face=&quot;Verdana&quot; style=&quot;font-weight: normal; font-size: 16px;&quot;&gt;遥感光谱指标提取&lt;/font&gt;" vertex="1">
          <mxGeometry height="260" width="510" x="1069" y="490" as="geometry">
