        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-106" parent="B4g4ZEUBLmSg_E4Tt5As-105" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;&lt;span style=&quot;font-size: 14px; font-family: Verdana; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;输入：&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Verdana; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Red, Green, Blue, NIR, SWIR1, SWIR2，&lt;/span&gt;&lt;span style=&quot;font-size: 14px; font-family: Verdana; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;DEM&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 14px; font-family: Verdana; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;计算指标：&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;NDWI = (Green - NIR) / (Green + NIR + ε)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;MNDWI = (Green - SWIR1) / (Green + SWIR1 + ε)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;ANDWI = (Red + Green + Blue) / (NIR + SWIR1 + SWIR2 + ε)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;NIR = NIR波段&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;DEM = DEM（作为第5通道）&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp;输出：X_spec [N, 5, H, W]&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; N: 样本数量&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; 5: [NDWI, MNDWI, ANDWI, NIR, DEM]&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; H, W: 空间尺寸（如 256×256)&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="480" x="10" y="40" as="geometry" />
        </mxCell>
