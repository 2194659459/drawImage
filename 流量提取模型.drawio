        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-122" parent="1" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=2;spacingRight=12;shape=cube;size=10;direction=south;fontStyle=4;html=1;whiteSpace=wrap;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;SpectralEncoder（光谱特征编码器）&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输入：[B, 5, H, W]&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;div style=&quot;&quot;&gt;输出：&lt;/div&gt;&lt;div style=&quot;&quot;&gt;spec_feat: [B, 48] - 光谱特征向量&lt;/div&gt;&lt;div style=&quot;&quot;&gt;attn_map: [B, 1, H, W] - 空间注意力图&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="280" x="1089" y="990" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-123" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#000000;align=center;" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-family: Verdana; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193)); font-size: 14px;&quot;&gt;X_geom: [B, 4]&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-family: Verdana; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193)); font-size: 14px;&quot;&gt;几何特征，&lt;/span&gt;&lt;span style=&quot;font-family: Verdana; background-color: transparent; color: light-dark(rgb(51, 51, 51), rgb(193, 193, 193)); font-size: 14px;&quot;&gt;面积, 平均宽度, 最大宽度, 宽度标准差&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="347" x="1459" y="790" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-124" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#000000;align=center;" value="&lt;font face=&quot;Verdana&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;X_phys: [B, 3]&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;物理参数（&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;h_swot深度 ,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;阶段1训练时，可选）&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="330" x="1819" y="790" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-125" parent="1" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=2;spacingRight=12;shape=cube;size=10;direction=south;fontStyle=4;html=1;whiteSpace=wrap;" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;GeometryMLP（几何特征编码器）&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输入：[B, 4]&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输出：geom_feat: [B, 32]&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="280" x="1429" y="990" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-126" parent="1" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=2;spacingRight=12;shape=cube;size=10;direction=south;fontStyle=4;html=1;whiteSpace=wrap;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;DepthPredictor（深度预测器）&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输入：&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;spec_feat: [B, 48]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;geom_feat: [B, 32]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;输出：pred_depth: [B&lt;/span&gt;&lt;span style=&quot;font-size: 14px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;]&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="280" x="1429" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-129" parent="1" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=2;spacingRight=12;shape=cube;size=10;direction=south;fontStyle=4;html=1;whiteSpace=wrap;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;Regressor（流量预测器）&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输入：&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;spec_feat: [B, 48]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;geom_feat: [B, 32]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;phys_feat: [B, 16]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输出：q_pred: [B] - 预测流量&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="300" x="1799" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-130" parent="1" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=2;spacingRight=12;shape=cube;size=10;direction=south;fontStyle=4;html=1;whiteSpace=wrap;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;PhysicalParameterPredictor（物理参数预测器）&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输入：&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;spec_feat: [B, 48]&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;geom_feat: [B, 32]&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输出：pred_phys: [B, 3] = [h0, n, S]&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="285" x="1089" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-131" parent="1" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=2;spacingRight=12;shape=cube;size=10;direction=south;fontStyle=4;html=1;whiteSpace=wrap;" value="&lt;span style=&quot;font-size: 14px;&quot;&gt;PhysicalParameterEncoder（物理参数编码器）&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输入：phys_params: [B, 3]（真实或预测的物理参数）&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;输出：phys_feat: [B, 16]&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="370" x="1769" y="990" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-134" parent="1" style="strokeWidth=2;html=1;shape=mxgraph.flowchart.annotation_2;align=left;labelPosition=right;pointerEvents=1;rotation=-90;" value="" vertex="1">
          <mxGeometry height="710" width="80" x="1564" y="840" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-135" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;&quot; face=&quot;Verdana&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;分段式模型训练&lt;/span&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="325" x="509" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-137" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;有SWOT监督学习&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="600" x="329" y="794" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-139" parent="B4g4ZEUBLmSg_E4Tt5As-137" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;训练数据&lt;/font&gt;&lt;/h1&gt;&lt;pre&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 14px;&quot;&gt;X_spec: [N, 5, H, W]&lt;br&gt;X_geom: [N, 4]&lt;br&gt;X_phys: [N, 3] - 标定的物理参数&lt;br&gt;h_swot: [N] - SWOT深度标签&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;y_true: [N] - 真实流量&lt;/span&gt;&lt;/font&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="150" width="210" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-140" parent="B4g4ZEUBLmSg_E4Tt5As-137" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;训练过程&lt;/h1&gt;&lt;pre&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;阶段1在有SWOT数据的区域进行监督学习，模型同时学习三个任务：流量预测、深度预测和物理参数预测。训练时，模型从影像和几何特征中提取深度相关信息并预测物理参数，但流量预测时使用标定的物理参数（而非预测值）以保证准确性；同时通过深度监督损失（预测深度与SWOT深度标签的差异）和物理参数监督损失（预测参数与标定参数的差异）来训练深度预测器和物理参数预测器，使模型学会从表面特征推断深度和物理参数。经过阶段1训练，模型掌握了深度相关特征提取、物理参数预测和特征融合的知识，这些知识存储在SpectralEncoder、GeometryMLP、DepthPredictor和PhysicalParameterPredictor的权重中。&lt;/span&gt;&lt;/font&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="160" width="530" x="40" y="170" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-141" parent="B4g4ZEUBLmSg_E4Tt5As-137" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;训练目标&lt;/font&gt;&lt;/h1&gt;&lt;pre&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 14px;&quot;&gt;✅ 学习深度相关特征（使用SWOT深度标签）&lt;br&gt;✅ 学习物理参数预测（使用标定的物理参数）&lt;br&gt;✅ 学习流量预测（使用真实流量标签）&lt;/font&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="140" width="300" x="280" y="30" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-142" parent="1" style="swimlane;horizontal=0;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Verdana&quot;&gt;有SWOT监督学习&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="600" x="329" y="1151" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-143" parent="B4g4ZEUBLmSg_E4Tt5As-142" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;训练数据&lt;/font&gt;&lt;/h1&gt;&lt;pre&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;X_spec: [N, 5, H, W]&lt;br/&gt;X_geom: [N, 4]&lt;br/&gt;y_true: [N] - 真实流量&lt;br/&gt;⚠️ 没有SWOT深度标签&lt;br/&gt;⚠️ 没有标定的物理参数&lt;/span&gt;&lt;/font&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="150" width="210" x="40" y="30" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-144" parent="B4g4ZEUBLmSg_E4Tt5As-142" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;训练过程&lt;/font&gt;&lt;/h1&gt;&lt;pre&gt;&lt;pre&gt;&lt;span style=&quot;font-family: Helvetica; white-space: normal; animation: 0.25s ease 0s 1 normal none running fade-in;&quot;&gt;阶段&lt;/span&gt;&lt;span style=&quot;font-family: Helvetica; white-space: normal; animation: 0.25s ease 0s 1 normal none running fade-in;&quot;&gt;2在无SWOT数据的场景下进行迁移学习，目标是让模型适应无SWOT环境。训练前，首先冻结深度预测器的参数以保持阶段1学到的深度相关特征知识；然后使用与阶段1相同的数据（但忽略SW&lt;/span&gt;&lt;span style=&quot;font-family: Helvetica; white-space: normal; animation: 0.25s ease 0s 1 normal none running fade-in;&quot;&gt;OT标签和物理参数），让模型使用自己预测的物理参数（而非标定的）进行流量预测，只计算流量损失并反向传播更新未冻结的参数。通过这种方式，模型在保持深度相关特征提取能力的同时，学会了在无SWOT场景下使用预测的物理参数准确预测流量，实现了从有SWOT区域到无SWOT区域的知识迁移。&lt;/span&gt;&lt;/pre&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="140" width="530" x="40" y="179" as="geometry" />
        </mxCell>
        <mxCell id="B4g4ZEUBLmSg_E4Tt5As-145" parent="B4g4ZEUBLmSg_E4Tt5As-142" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;训练目标&lt;/font&gt;&lt;/h1&gt;&lt;ul style=&quot;margin: 0px; padding: 0px; box-sizing: border-box; font-family: &amp;quot;Microsoft YaHei&amp;quot;, SimHei, Arial, sans-serif; font-size: medium;&quot;&gt;&lt;li style=&quot;margin: 0px; padding: 0px; box-sizing: border-box;&quot;&gt;✅ 适应无SWOT场景（不依赖SWOT数据）&lt;/li&gt;&lt;li style=&quot;margin: 0px; padding: 0px; box-sizing: border-box;&quot;&gt;✅ 保持学到的知识（冻结深度预测器）&lt;/li&gt;&lt;li style=&quot;margin: 0px; padding: 0px; box-sizing: border-box;&quot;&gt;✅ 优化流量预测（只使用流量标签）&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="140" width="330" x="270" y="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
